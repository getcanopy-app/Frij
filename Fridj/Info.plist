<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- frij:// exists so the home-screen widget can open straight into the
	     camera. Universal links (hellofrij.com) still handle shared recipes;
	     this is only for our own widget, which can't use a web URL without
	     bouncing through Safari. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hellofrij.frij</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>frij</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
