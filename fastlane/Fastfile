# fastlane warns (and can mangle text) when the shell locale isn't UTF-8. The
# App Store description uses em-dashes and curly quotes, so pin it here rather
# than relying on whatever the calling shell happens to have.
ENV["LANG"] ||= "en_US.UTF-8"
ENV["LC_ALL"] ||= "en_US.UTF-8"

default_platform(:ios)

platform :ios do
  desc "Upload App Store metadata only (name, subtitle, keywords, description)."
  desc "Takes effect on the next editable version — see fastlane/Deliverfile."
  # App Store Connect API key instead of an Apple ID. No password, no 2FA, and
  # it sidesteps the spaceship Apple-ID login bug ("Service key is empty").
  # The .p8 lives outside the repo at ~/.appstoreconnect/private_keys/ so it
  # can never be committed; only the non-secret ids are here.
  def asc_key
    app_store_connect_api_key(
      key_id: "A28C7VX45X",
      issuer_id: "db4c8ca6-d5a9-4270-893c-13e469aca1e5",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_A28C7VX45X.p8"),
      in_house: false,
    )
  end

  # Uploading a build does NOT create the App Store version record — that is a
  # separate thing, and metadata can only be written to an editable version.
  # Passing app_version makes deliver create it if it doesn't exist.
  #   fastlane aso                 -> HTML preview, asks before sending
  #   fastlane aso force:true      -> no preview (for when you've already reviewed)
  lane :aso do |options|
    deliver(
      api_key: asc_key,
      app_version: options[:version] || "1.0.4",
      force: options[:force] ? true : false,
    )
  end

  desc "Check the API key authenticates, without changing anything."
  lane :aso_check do
    key = asc_key
    app = Spaceship::ConnectAPI::App.find("com.hellofrij.frij")
    UI.user_error!("Could not find com.hellofrij.frij with this key") if app.nil?
    versions = app.get_app_store_versions
    UI.success("Authenticated. App: #{app.name} (#{app.id})")
    versions.first(3).each do |v|
      UI.message("  version #{v.version_string} — #{v.app_store_state}")
    end
    UI.important("Metadata can only be written to an editable version.")

    # Read back what is actually live. deliver reports success even when it
    # decides nothing changed, and the app NAME lives in App Info (app-level),
    # not in the version's metadata — so verify both, separately.
    editable = versions.find { |v| %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED
                                      REJECTED METADATA_REJECTED WAITING_FOR_REVIEW].include?(v.app_store_state) }
    if editable
      UI.success("Editable version: #{editable.version_string} (#{editable.app_store_state})")
      loc = editable.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
      if loc
        UI.message("  keywords : #{loc.keywords}")
        UI.message("  promo    : #{loc.promotional_text}")
        UI.message("  desc[0,60]: #{loc.description.to_s[0, 60]}...")
      end
    else
      UI.error("No editable version — metadata cannot be written.")
    end

    info = app.get_app_infos.find { |i| i.app_store_state != "READY_FOR_SALE" } || app.get_app_infos.first
    if info
      il = info.get_app_info_localizations.find { |l| l.locale == "en-US" }
      UI.message("  app name : #{il&.name}")
      UI.message("  subtitle : #{il&.subtitle}")
    end
  end

  desc "Show exactly what 1.0.4 still needs before it can be submitted."
  lane :release_status do
    asc_key
    app = Spaceship::ConnectAPI::App.find("com.hellofrij.frij")
    version = app.get_edit_app_store_version
    if version.nil?
      UI.error("No editable version. Create one in App Store Connect.")
      next
    end
    UI.success("Version #{version.version_string} — #{version.app_store_state}")

    build = version.build
    UI.message(build ? "  build attached: #{build.version} (#{build.processing_state})"
                     : "  build attached: NONE")

    UI.header("Builds uploaded for this version")
    builds = app.get_builds(filter: { "preReleaseVersion.version" => version.version_string })
    builds = app.get_builds if builds.empty?
    builds.first(5).each do |b|
      UI.message("  #{b.version}  #{b.processing_state}  expired=#{b.expired}")
    end

    loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.header("Metadata")
    UI.message("  whats_new : #{loc&.whats_new.to_s.empty? ? '(EMPTY — required)' : loc.whats_new.to_s[0, 60]}")
    UI.message("  keywords  : #{loc&.keywords.to_s[0, 50]}")
  end

  desc "Attach the latest valid build to the editable version and upload release notes."
  lane :prepare_release do |options|
    asc_key
    app = Spaceship::ConnectAPI::App.find("com.hellofrij.frij")
    version = app.get_edit_app_store_version
    UI.user_error!("No editable version") if version.nil?

    build_number = options[:build]
    builds = app.get_builds.select { |b| b.processing_state == "VALID" && !b.expired }
    build = build_number ? builds.find { |b| b.version == build_number.to_s } : builds.first
    UI.user_error!("No VALID build found") if build.nil?

    version.select_build(build_id: build.id)
    UI.success("Attached build #{build.version} to #{version.version_string}")

    # Release notes come from fastlane/metadata/en-US/release_notes.txt via the
    # normal deliver pipeline — no bespoke file reading here, which was also
    # fragile about fastlane's working directory.
    UI.important("Now run: fastlane aso force:true   (uploads release notes)")
  end


  desc "Submit the editable version to App Review. Irreversible-ish: pulling it"
  desc "back means Developer Rejecting the submission."
  lane :submit do
    deliver(
      api_key: asc_key,
      app_version: "1.0.4",
      submit_for_review: true,
      force: true,
      # Declarations Apple asks on every submission. Accurate for Frij:
      #   - encryption: HTTPS only, which is exempt
      #   - third-party content: recipes/images are generated for the user
      #   - IDFA: Frij does no ad tracking
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
        add_id_info_uses_idfa: false,
      },
      automatic_release: true,
    )
  end


  desc "Turn on a capability for the App ID (e.g. HealthKit) so signing can use it."
  desc "Xcode does this when you tick the box in Signing & Capabilities; the"
  desc "entitlements file alone is not enough — export fails without it."
  lane :enable_capability do |options|
    asc_key
    type = options[:type] || "HEALTHKIT"
    bundle = Spaceship::ConnectAPI::BundleId.find("com.hellofrij.frij")
    UI.user_error!("Bundle ID not found") if bundle.nil?
    existing = bundle.get_capabilities.map(&:capability_type)
    UI.message("Current: #{existing.join(', ')}")
    if existing.include?(type)
      UI.success("#{type} already enabled.")
    else
      bundle.create_capability(type)
      UI.success("Enabled #{type} on com.hellofrij.frij")
    end
  end

  desc "Pre-review audit: what is actually filled in, and what is missing."
  lane :review_audit do
    asc_key
    app = Spaceship::ConnectAPI::App.find("com.hellofrij.frij")
    v = app.get_app_store_versions.first
    UI.header("Version #{v.version_string} — #{v.app_store_state}")

    b = v.build
    UI.message("build            : #{b&.version} uploaded #{b&.uploaded_date}")
    UI.message("release type     : #{v.release_type}")

    loc = v.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    %w[description keywords whats_new promotional_text support_url marketing_url].each do |f|
      val = loc.send(f).to_s
      UI.message(format("%-17s: %s", f, val.empty? ? "(EMPTY)" : "#{val.length} chars"))
    end

    UI.message("name             : " + app.name.to_s)

    UI.header("Screenshots")
    sets = loc.get_app_screenshot_sets
    sets.each { |s| UI.message("  #{s.screenshot_display_type}: #{s.app_screenshots.count}") }
    UI.error("  NO SCREENSHOTS — Apple will reject") if sets.empty?
  end

end
